# ==============================================================================
# BELMA BEAUTY — Environment Variables Template (Neon Postgres + Vercel)
# ==============================================================================

# 1. Neon Postgres Connection String (WAJIB untuk Vercel & Neon)
# Salin langsung dari Neon Console -> Connection Details -> Connection string
DATABASE_URL="postgresql://neondb_owner:your_password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. Admin & Reseller Session Signing Secret (Isi string acak panjang di Vercel)
ADMIN_SESSION_SECRET="replace-with-strong-random-session-secret"

# 3. App Public URL (Contoh di Vercel: https://belma-beauty.vercel.app)
APP_URL="MY_APP_URL"

# 4. GEMINI_API_KEY: Required if Gemini AI API calls are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
